#!/usr/bin/env bash
# Runs the Inferno SMART App Launch STU2.2 client harness: Phase 1 (Backend Services)
# and Phase 2 (authorization code: standalone and EHR launch, plus negative controls).
# See compliance/inferno/README.md. Requires Docker with the compose plugin.
#
# Environment (all optional):
#   INFERNO_KIT_TAG     test kit tag to clone            (default v1.0.3)
#   INFERNO_KIT_REF     commit the tag must resolve to   (default 980e54e…)
#   INFERNO_KIT_DIR     where the kit is cloned          (default tmp/smart-app-launch-test-kit)
#   INFERNO_REPORT_DIR  where results.json/report.html go (default tmp/inferno);
#                       the Phase 2 report goes to $INFERNO_REPORT_DIR/app-launch
#   INFERNO_SCENARIOS   comma-separated Phase 2 scenario ids to run (default: all)
#   INFERNO_KEEP=1      leave the Inferno container running afterwards
set -euo pipefail

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
export INFERNO_KIT_TAG="${INFERNO_KIT_TAG:-v1.0.3}"
export INFERNO_KIT_REF="${INFERNO_KIT_REF:-980e54e4ed632b28267d797013399a8588772174}"
export INFERNO_KIT_DIR="${INFERNO_KIT_DIR:-$ROOT/tmp/smart-app-launch-test-kit}"
export INFERNO_REPORT_DIR="${INFERNO_REPORT_DIR:-$ROOT/tmp/inferno}"
export INFERNO_URL="http://localhost:4567"
COMPOSE=(docker compose -f "$ROOT/compliance/inferno/docker-compose.yml")

if docker image inspect "safire-inferno-smart:$INFERNO_KIT_REF" >/dev/null 2>&1; then
  echo "Using existing image safire-inferno-smart:$INFERNO_KIT_REF"
else
  if [ ! -d "$INFERNO_KIT_DIR" ]; then
    git clone --quiet --depth 1 --branch "$INFERNO_KIT_TAG" \
      https://github.com/inferno-framework/smart-app-launch-test-kit.git "$INFERNO_KIT_DIR"
  fi
  actual="$(git -C "$INFERNO_KIT_DIR" rev-parse HEAD)"
  if [ "$actual" != "$INFERNO_KIT_REF" ]; then
    echo "Test kit checkout is at $actual, expected $INFERNO_KIT_REF" >&2
    exit 1
  fi
  "${COMPOSE[@]}" build
fi

cleanup() {
  status=$?
  if [ "$status" -ne 0 ]; then "${COMPOSE[@]}" logs --tail 100 inferno || true; fi
  if [ "${INFERNO_KEEP:-0}" != "1" ]; then "${COMPOSE[@]}" down --volumes || true; fi
  exit "$status"
}
trap cleanup EXIT

"${COMPOSE[@]}" up --detach --wait
cd "$ROOT"
export INFERNO_APP_LAUNCH_REPORT_DIR="$INFERNO_REPORT_DIR/app-launch"
backend=0
bundle exec ruby compliance/inferno/backend_services_run.rb || backend=$?
echo "Phase 1 report: $INFERNO_REPORT_DIR/report.html (exit $backend)"
app_launch=0
bundle exec ruby compliance/inferno/app_launch_run.rb || app_launch=$?
echo "Phase 2 report: $INFERNO_APP_LAUNCH_REPORT_DIR/report.html (exit $app_launch)"
[ "$backend" -eq 0 ] && [ "$app_launch" -eq 0 ]
