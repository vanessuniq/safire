<h1>Welcome to Safire Demo</h1>

<p>
  This application demonstrates the capabilities of the <strong>Safire</strong> gem —
  a Ruby client for SMART App Launch 2.2.0 and UDAP 2.0.0 - STU 2.
</p>

<section class="info-box">
  <h2>Getting Started</h2>
  <p>Choose how you want to connect to a FHIR authorization server:</p>

  <div class="action-cards getting-started-actions">
    <div class="action-card">
      <h3>Register Dynamically</h3>
      <p>
        Use a protocol-specific Dynamic Client Registration flow when the server can
        issue credentials to this demo client.
      </p>

      <div class="protocol-action-stack">
        <div class="protocol-action-row">
          <div>
            <strong>SMART App Launch</strong>
            <span>Register with a SMART server and create a server entry automatically.</span>
          </div>
          <a href="/register" class="btn btn-primary btn-small">SMART DCR</a>
        </div>

        <div class="protocol-action-row">
          <div>
            <strong>UDAP Security</strong>
            <span>Register this demo client's certificate-backed software statement with an unregistered UDAP server.</span>
          </div>
          <% if @udap_registration_servers.any? %>
            <div class="protocol-action-links">
              <% @udap_registration_servers.each do |server| %>
                <a href="/demo/<%= server.id %>/udap-registration" class="btn btn-secondary btn-small">
                  <%= h(server.name) %>
                </a>
              <% end %>
            </div>
          <% else %>
            <a href="/servers/new" class="btn btn-secondary btn-small">Add UDAP Server</a>
          <% end %>
        </div>
      </div>
    </div>

    <div class="action-card">
      <h3>Add Server Manually</h3>
      <p>
        Configure SMART credentials, UDAP discovery, or both for a FHIR server.
      </p>
      <p class="form-hint">
        Callback URL to register with your server:<br>
        <code><%= h(redirect_uri) %></code>
      </p>
      <a href="/servers/new" class="btn btn-secondary">Add Server</a>
    </div>
  </div>
</section>

<section class="servers-section">
  <div class="section-header">
    <h2>Configured Servers</h2>
  </div>

  <% if @servers.empty? %>
    <p class="empty-state">No servers configured yet. Register dynamically or add one manually to get started.</p>
  <% else %>
    <div class="server-list">
      <% @servers.each do |server| %>
        <div class="server-card">
          <div class="server-info">
            <h3><a href="/servers/<%= server.id %>"><%= h(server.name) %></a></h3>
            <p class="server-url"><%= h(server.base_url) %></p>
            <p class="server-meta">
              <% server.protocols.each do |protocol| %>
                <span class="badge badge-protocol badge-protocol-<%= h(protocol) %>">
                  <%= h(FhirServer::PROTOCOL_LABELS.fetch(protocol, protocol)) %>
                </span>
              <% end %>
              <% if server.confidential? %>
                <span class="badge badge-info">Confidential Client</span>
              <% end %>
            </p>
          </div>
          <div class="server-actions">
            <a href="/servers/<%= server.id %>" class="btn btn-small">View</a>
          </div>
        </div>
      <% end %>
    </div>
  <% end %>
</section>
