#!/bin/sh
# Generate the YARD API docs into docs/api and confirm the navigation fix below.
# Exits nonzero if YARD fails or the navigation fix is missing, so CI never
# builds the Jekyll site from stale or broken API docs.
set -eu

cd "$(dirname "$0")/.."

# docs/api is generated and gitignored. Remove it first so a failed YARD run
# cannot leave output from an earlier run behind looking fresh.
rm -rf docs/api

bundle exec yard doc --no-private --output-dir docs/api -m markdown

# YARD navigation: nav iframe links are relative to the iframe base URL, but
# app.js resolves them against the parent window URL (which changes on
# navigation). YARD's own template now converts them to absolute URLs inside
# the iframe before posting the navigate message, so Safire no longer patches
# the file. Check that the fix is still there, so a YARD template change
# cannot silently bring back broken navigation.
ruby - docs/api/js/full_list.js <<'RUBY'
file = ARGV.fetch(0)
upstream = 'url = new URL(url, window.location.href).href;'

abort "bin/docs: #{file} not found; cannot confirm YARD navigation fix" unless File.file?(file)

unless File.read(file).include?(upstream)
  abort "bin/docs: YARD navigation fix not found in #{file}; YARD template may have changed. " \
        "Expected: #{upstream}"
end

puts "bin/docs: #{file} resolves navigation links to absolute URLs"
RUBY
