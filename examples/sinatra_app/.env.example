# Safire Demo App Environment Configuration
# bin/demo creates examples/sinatra_app/.env from this template when needed and
# fills local-only demo defaults that are safe to keep out of git. Edit .env if
# you need production-style trust material or externally issued client credentials.

# ============================================
# Session Secret (required)
# ============================================
# Generate with: ruby -e "require 'securerandom'; puts SecureRandom.hex(32)"
# bin/demo fills this when absent.
SESSION_SECRET=your_session_secret_here

# ============================================
# Asymmetric Client Authentication (optional)
# ============================================
# These are CLIENT-level credentials (same for all FHIR servers).
# For confidential asymmetric authentication (private_key_jwt).

# Private Key in PEM format
# Generate RSA key: openssl genrsa -out private_key.pem 2048
# Generate EC key:  openssl ecparam -name secp384r1 -genkey -noout -out private_key.pem
#
# Paste the contents of your private key file here (include the BEGIN/END lines):
# bin/demo fills this when absent for local asymmetric SMART demo flows.
ASYMMETRIC_PRIVATE_KEY_PEM="-----BEGIN RSA PRIVATE KEY-----
...your private key content here...
-----END RSA PRIVATE KEY-----"

# Key ID (kid)
# This must match the kid in your registered JWKS with the authorization server.
# Use a unique identifier like a UUID or a descriptive name.
# bin/demo fills this when absent.
ASYMMETRIC_KID=my-app-key-001

# ============================================
# UDAP Discovery signed_metadata Trust Policy (optional)
# ============================================
# Leave these blank for local demos. The UDAP Discovery screen will validate
# signed_metadata without X.509 chain/revocation checks and show a warning.
#
# For production-style testing, provide both trust anchors and CRLs. When both
# are present, the demo enables verify_chain by default.

UDAP_TRUST_ANCHORS_PEM=""
UDAP_CRLS_PEM=""

# Optional override.
# Accepted true values: 1, true, yes, on.
# Accepted false values: 0, false, no, off.
# Unknown values raise a configuration error instead of disabling validation.
UDAP_VERIFY_CHAIN=""

# ============================================
# UDAP Client Signing Credentials (optional)
# ============================================
# These are CLIENT-level credentials used to sign UDAP Dynamic Client
# Registration software statements. They are separate from the server trust
# anchors above.
#
# For interoperability testing, prefer an issued UDAP test certificate over the
# generated self-signed demo certificate. See the Testing Resources section on
# https://www.udap.org/ for UDAP Developer account and Test Tool access.

# Client metadata defaults for the UDAP registration screen.
UDAP_CLIENT_NAME="Safire Demo App"
UDAP_CLIENT_CONTACTS="mailto:admin@example.com"
UDAP_CLIENT_LOGO_URI=""
# Optional path to a local file containing compact JWS certification JWTs, one
# per line. Relative paths resolve from examples/sinatra_app. Required when the
# server's UDAP metadata advertises udap_certifications_required.
# bin/demo fills this with data/udap_self_signed_certification.jwt when absent.
# Custom paths must already identify a non-empty file; bin/demo creates files
# only at its managed default path.
# Generated demo credentials and certification JWTs expire after one year. See
# the demo README for the refresh procedure.
UDAP_CLIENT_CERTIFICATIONS_FILE=""

# Private key in PEM format. The public key must match the leaf certificate in
# UDAP_CLIENT_CERTIFICATE_CHAIN_PEM.
# Example value:
# UDAP_CLIENT_PRIVATE_KEY_PEM="-----BEGIN PRIVATE KEY-----
# ...your UDAP client private key content here...
# -----END PRIVATE KEY-----"
# bin/demo fills this when absent for local UDAP DCR demo flows.
UDAP_CLIENT_PRIVATE_KEY_PEM=""

# Leaf-first, issuer-ordered certificate chain in PEM format.
# Example value:
# UDAP_CLIENT_CERTIFICATE_CHAIN_PEM="-----BEGIN CERTIFICATE-----
# ...your UDAP client leaf certificate...
# -----END CERTIFICATE-----
# -----BEGIN CERTIFICATE-----
# ...optional issuing certificate...
# -----END CERTIFICATE-----"
# bin/demo fills this when absent with a self-signed certificate whose URI SAN
# matches http://localhost:PORT.
UDAP_CLIENT_CERTIFICATE_CHAIN_PEM=""

# Optional explicit software-statement signing algorithm.
# Supported values: RS256, RS384, ES256, ES384.
# Leave blank to let Safire select a compatible algorithm from UDAP discovery.
# bin/demo fills this with RS256 when absent.
UDAP_REGISTRATION_SIGNING_ALGORITHM=""

# ============================================
# Notes on Asymmetric Authentication
# ============================================
#
# 1. The app automatically serves your public key at:
#    http://localhost:PORT/.well-known/jwks.json
#
# 2. Register your app with the FHIR server's authorization server:
#    - Provide your JWKS URL (the above endpoint)
#    - Or upload your public key directly
#
# 3. Extract your public key from the private key:
#    openssl rsa -in private_key.pem -pubout -out public_key.pem
#
# 4. The app supports both RSA (RS384) and EC P-384 (ES384) keys.
#
# 5. For production, use HTTPS for your JWKS endpoint.
#    Authorization servers may reject HTTP URLs.
